# Copy to .env and fill in.  (cp .env.example .env)
LLM_PROVIDER=gemini            # gemini | openai | anthropic
# LLM_MODEL=gemini-2.5-flash   # optional override
GOOGLE_API_KEY=your-gemini-key
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Database backend: postgres (the provided container) | duckdb (local file, no container)
DB_BACKEND=duckdb
DUCKDB_PATH=network_rca.duckdb
# Build the DuckDB file once with one of:
#   python -m scripts.build_duckdb --from-csv ../db/init     (challenge seed data, recommended)
#   python -m scripts.build_duckdb --from-postgres           (copy the running container)
#   python -m scripts.build_duckdb --demo                    (small synthetic dataset)

# Postgres settings (used when DB_BACKEND=postgres, and by --from-postgres).
# From VS Code on your machine use localhost; inside the Jupyter container use the
# compose service name (usually "postgres" / "db" - check podman-compose.yml).
PGHOST=localhost
PGPORT=5432
PGDATABASE=network_rca
PGUSER=postgres
PGPASSWORD=postgres
# or: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/network_rca

MAX_INVESTIGATION_STEPS=8
